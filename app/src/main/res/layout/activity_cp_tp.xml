<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/header_blue"
        app:title="CP &amp; TP Pembelajaran"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Capaian Pembelajaran -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capaian Pembelajaran (CP)"
                        android:textColor="@color/header_blue"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pada akhir fase F (Kelas XI dan XII), peserta didik mampu melakukan perawatan berkala, melakukan perbaikan, dan melakukan instalasi ulang pada perangkat keras dan perangkat lunak komputer. Peserta didik mampu mendiagnosis dan memecahkan masalah (troubleshooting) yang terjadi pada perangkat keras, sistem operasi, dan aplikasi."
                        android:textColor="@color/text_title"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tujuan Pembelajaran -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tujuan Pembelajaran (TP)"
                        android:textColor="@color/header_blue"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Mendiagnosis kerusakan pada perangkat keras komputer (Power Supply, Motherboard, RAM, HDD/SSD, VGA).\n\n2. Melakukan perbaikan dan penggantian komponen perangkat keras yang rusak.\n\n3. Melakukan perawatan rutin (maintenance) pada perangkat keras komputer.\n\n4. Mendiagnosis masalah pada sistem operasi dan perangkat lunak.\n\n5. Melakukan instalasi ulang dan konfigurasi driver perangkat keras.\n\n6. Menerapkan prosedur Keselamatan dan Kesehatan Kerja serta Lingkungan Hidup (K3LH) dalam troubleshooting."
                        android:textColor="@color/text_title"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>